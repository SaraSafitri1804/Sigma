# Salin file ini jadi ".env" lalu sesuaikan
# --- PostgreSQL (satu server, database dipisah per service) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
AUTH_DB_NAME=auth_db
DOCUMENT_DB_NAME=document_db
SIGNING_DB_NAME=signing_db

# --- Keamanan ---
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=1d
# Kunci untuk komunikasi antar service (jangan dibagikan ke frontend)
INTERNAL_KEY=ganti-dengan-kunci-internal-acak

# --- Port ---
GATEWAY_PORT=3000
AUTH_PORT=3001
DOCUMENT_PORT=3002
SIGNING_PORT=3003
QRPDF_PORT=3004
VERIFICATION_PORT=3005
FRONTEND_URL=http://localhost:5173

# --- Tahap 2-4 ---
# Alamat yang ditulis ke dalam QR pada dokumen (alamat Frontend). Untuk dipindai dari HP lain,
# jangan pakai localhost: pakai IP laptop (satu WiFi), mis. http://192.168.1.5:5173, atau domain/tunnel.
PUBLIC_URL=http://localhost:5173
# Opsional: lokasi soffice (LibreOffice) bila tidak ditemukan otomatis. Contoh Windows:
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=
