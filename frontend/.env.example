# Salin jadi ".env" bila perlu. Tanpa file ini, frontend memakai API sungguhan lewat Gateway.

# true  = Dokumen, Tanda Tangan, dan Verifikasi memakai DATA CONTOH di browser (tanpa backend Tahap 2-4)
# false = memakai API sungguhan (bawaan)
VITE_USE_MOCK=false

# Dipakai hanya pada mode contoh. Pada mode API sungguhan, alamat QR ditentukan oleh PUBLIC_URL di .env utama.
# Kosongkan untuk memakai alamat yang sedang dibuka di browser.
VITE_PUBLIC_URL=

# Alamat Gateway. Kosongkan untuk memakai proxy Vite (/api -> localhost:3000)
VITE_API_URL=
